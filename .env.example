# ==============================================================================
# GREENANDCOOP - FORECAST 2.0 : TEMPLATE DES VARIABLES D'ENVIRONNEMENT
# Copiez ce fichier vers ".env" et remplacez les valeurs d'exemple par vos secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES LOCALE POSTGRESQL (p8_postgres)
# ------------------------------------------------------------------------------
LOCAL_PG_HOST=p8_postgres
LOCAL_PG_PORT_INTERNAL=5432
LOCAL_PG_PORT_EXTERNAL=5433
LOCAL_PG_DB=greenandcoop_db
LOCAL_PG_USER=mikael
LOCAL_PG_PASSWORD=VotreMotDePasseLocalIci2026!

# ------------------------------------------------------------------------------
# 2. SERVICE SFTP LOCAL D'INGESTION AIRBYTE (p8_sftp)
# ------------------------------------------------------------------------------
SFTP_USER=mikael
SFTP_PASSWORD=VotreMotDePasseSftpIci2026!
SFTP_UID=1001
SFTP_GID=1001

# ------------------------------------------------------------------------------
# 3. BASE DISTANTE AMAZON RDS POSTGRESQL (Étape 5 Cloud)
# ------------------------------------------------------------------------------
AWS_REGION=eu-north-1
AWS_ACCOUNT_ID=000000000000
AWS_RDS_ENDPOINT=greenandcoop-rds-prod.xxxxxx.eu-north-1.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DB=greenandcoop_db
AWS_RDS_USER=mikael
AWS_RDS_PASSWORD=VotreMotDePasseCloudRDSComplexe2026!

# ------------------------------------------------------------------------------
# 4. SERVICES DE CALCUL & CONTENEURS AWS (ECS Fargate & ECR)
# ------------------------------------------------------------------------------
ECR_REPOSITORY_NAME=greenandcoop/dbt-prod
ECS_CLUSTER_NAME=greenandcoop-cluster
ECS_TASK_FAMILY=greenandcoop-dbt-task
CLOUDWATCH_LOG_GROUP=/ecs/greenandcoop-dbt-prod

# ------------------------------------------------------------------------------
# 5. PORTS ET CONFIGURATIONS RÉSEAU
# ------------------------------------------------------------------------------
AIRBYTE_WEB_PORT=8000
DBT_DOCS_PORT=8086
DBT_HTTP_FILES_PORT=8089